# Copie para .env na VPS e preencha. NUNCA commitar o .env.
DOMAIN=omnihub.adapterco.com.br
POSTGRES_PASSWORD=
# >=32 caracteres aleatórios (ex.: openssl rand -hex 32). Criptografa certificados A1/CSC — perdê-la inutiliza os certificados salvos.
FISCAL_SECRET_KEY=
FISCAL_WORKER_INTERVAL_MS=30000
# Opcionais de segurança:
# REGISTRATION_ENABLED=false   # desativa o cadastro público de novas contas
# TRUSTED_PROXY_HOPS=1         # nº de proxies confiáveis na frente do app (2 se Cloudflare + Traefik)
# Backup automático (serviço "backup" do docker-compose.yml):
# BACKUP_INTERVAL_SECONDS=86400   # a cada quantos segundos gerar um dump (padrão 24 h)
# BACKUP_RETENTION_DAYS=14        # dias de retenção (os 3 mais recentes nunca são apagados)
# LOG_LEVEL=info                  # debug | info | warn | error
# PAYMENT_WORKER_INTERVAL_MS=20000  # reconciliação das cobranças integradas (0 desliga)
# STORAGE_DIR=/data/storage  # arquivos de contratos/anexos (no docker-compose já vem definido, com volume próprio)
# ADAPTER_SIGN_BASE_URL=https://sign.adapterco.com.br/api/v1  # endereço da API do Adapter Sign (padrão: o documentado)
# SIGNATURE_WORKER_INTERVAL_MS=60000  # reconciliação das assinaturas (0 desliga)

# Conferência automática dos boletos Asaas (ms; 0 desliga). Opcional, padrão 60000.
# BILLING_WORKER_INTERVAL_MS=60000

# Recuperação de senha por e-mail ("Esqueci minha senha"). Opcional: sem TODAS as variáveis abaixo,
# a recuperação fica desligada e a tela orienta a pedir ao administrador (Equipe > Definir acesso).
# SMTP_SECURE=true para TLS direto (porta 465) ou false para STARTTLS (porta 587) — conforme o provedor.
# APP_URL é o endereço público do OmniHub usado no link do e-mail (https obrigatório).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=OmniHub <no-reply@seudominio.com.br>
# APP_URL=https://omnihub.adapterco.com.br

# Limpeza de eventos de webhook resolvidos (90 dias) e credenciais temporárias vencidas (ms; 0 desliga). Opcional, padrão 6 h.
# MAINTENANCE_INTERVAL_MS=21600000
