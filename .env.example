# Copie para .env na VPS e preencha. NUNCA commitar o .env.
DOMAIN=omnihub.adapterco.com.br
POSTGRES_PASSWORD=
# >=32 caracteres aleatórios (ex.: openssl rand -hex 32). Criptografa certificados A1/CSC — perdê-la inutiliza os certificados salvos.
FISCAL_SECRET_KEY=
FISCAL_WORKER_INTERVAL_MS=30000
# Opcionais de segurança:
# REGISTRATION_ENABLED=false   # desativa o cadastro público de novas contas
# TRUSTED_PROXY_HOPS=1         # nº de proxies confiáveis na frente do app (2 se Cloudflare + Traefik)
# Backup automático (serviço "backup" do docker-compose.yml):
# BACKUP_INTERVAL_SECONDS=86400   # a cada quantos segundos gerar um dump (padrão 24 h)
# BACKUP_RETENTION_DAYS=14        # dias de retenção (os 3 mais recentes nunca são apagados)
# LOG_LEVEL=info                  # debug | info | warn | error
# PAYMENT_WORKER_INTERVAL_MS=20000  # reconciliação das cobranças integradas (0 desliga)
